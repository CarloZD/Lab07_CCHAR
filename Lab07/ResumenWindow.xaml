<Window x:Class="Lab07.ResumenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Resumen por categoría" Height="460" Width="620"
        WindowStartupLocation="CenterOwner"
        Background="#F3F5F8" FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="Resumen por categoría" FontSize="20" FontWeight="SemiBold" Foreground="#1B2A41"/>
            <TextBlock Text="Productos activos agrupados con LINQ (inner join y group by)" Foreground="#5B6776" Margin="0,2,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Background="White" CornerRadius="10" BorderBrush="#D8DEE6"
                BorderThickness="1" Padding="12">
            <DataGrid x:Name="DgResumen" AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#E8ECF1" BorderThickness="0" Background="White"
                      RowHeight="32" CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Categoría" Binding="{Binding NombreCategoria}" Width="*"/>
                    <DataGridTextColumn Header="Productos" Binding="{Binding CantidadProductos}" Width="90"/>
                    <DataGridTextColumn Header="Stock total" Binding="{Binding StockTotal}" Width="100"/>
                    <DataGridTextColumn Header="Precio promedio" Binding="{Binding PrecioPromedio, StringFormat=N2}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Window>
